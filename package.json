{
  "name": "methacity",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --conditions=react-server --test \"src/**/*.test.ts\"",
    "test:coverage": "tsx --conditions=react-server --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.test.ts\" --test-coverage-exclude=\"src/app/**\" --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "next": "^15.5.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "three": "^0.183.1",
    "zod": "^3.24.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
