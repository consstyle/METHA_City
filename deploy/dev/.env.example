# MethaCity · desarrollo · variables de entorno (plantilla)
# Copiar a .env (chmod 600) y rellenar. NUNCA subir el .env a ningún repositorio.
# En Dokploy: pegar las mismas variables en la pestaña Environment del servicio.
# Generar cada secreto con:  openssl rand -hex 24
#
# Las claves de modelos (Anthropic, OpenAI…) NO van aquí: las introduce el asistente
# `setup` de Hermes directamente en su volumen (ver README, paso 4).

# Superusuario del Postgres de la réplica de MethaDesk
POSTGRES_SUPERUSER_PASSWORD=

# Propietario de las tablas de la réplica (equivale a `postgres` en el Supabase de MethaDesk)
MD_OWNER_PW=

# Roles de solo lectura de MethaCity (los crea sql/01_rollen.sql; aquí solo se fija la contraseña)
MC_READONLY_PW=
MC_AUTH_PW=
# Solo si ENABLE_FINANZ=1 (sql/06_opcional_finanzas.sql)
MC_FINANZ_PW=
ENABLE_FINANZ=0

# API de Hermes: perfil por defecto (puerto 8642) y perfil chief (puerto 8643)
HERMES_API_KEY=
HERMES_CHIEF_API_KEY=
