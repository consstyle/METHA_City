# MethaCity · demo del MVP (F5b). Copia a .env SOLO en el VPS (opción B) o pon estas variables en
# Dokploy → pestaña Environment (opción A). Nunca en el repositorio ni en el chat.

# Subdominio de la demo, con un registro DNS A hacia la IP del VPS (solo opción B; en la opción A
# el dominio se configura en la pestaña Domains de Dokploy).
DEMO_HOST=

# Acceso temporal (D22). Usuario sin «:»; contraseña de al menos 16 caracteres, generada (ASCII):
#   openssl rand -base64 24
DEMO_USER=
DEMO_PASSWORD=
